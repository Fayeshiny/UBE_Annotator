# Copy to production.env (gitignored), then use absolute paths for this server.
SSI_DATA_DIR=/absolute/path/to/annotator/data-production
SSI_HOST=127.0.0.1
SSI_PORT=8002
# Set to 1 when the browser accesses this service through HTTPS.
SSI_COOKIE_SECURE=0
# mock is only for training; set sam3.1 for real segmentation.
SSI_SAM_BACKEND=mock
SSI_FRAME_CACHE_MAX_MB=2048
SSI_FRAME_CACHE_PREWARM=1
# SSI_SAM_CHECKPOINT=/absolute/path/to/annotator/models/sam3.1/sam3.1_multiplex.pt
# CUDA_VISIBLE_DEVICES=2
# SSI_SAM_USE_FA3=0
